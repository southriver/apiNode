{
  "serviceName": "todo-api-course",
  "executionRoleArn": "arn:aws:iam::796399051022:role/ecsTaskExecutionRole",
  "infrastructureRoleArn": "arn:aws:iam::796399051022:role/ecsInfrastructureRoleForExpressServices",
  "primaryContainer": {
    "image": "796399051022.dkr.ecr.eu-central-1.amazonaws.com/apinode:ecs-course",
    "containerPort": 8080,
    "environment": [
      { "name": "PORT", "value": "8080" },
      { "name": "NODE_ENV", "value": "production" }
    ]
  },
  "healthCheckPath": "/",
  "cpu": "256",
  "memory": "512",
  "scalingTarget": {
    "minTaskCount": 1,
    "maxTaskCount": 1
  }
}
